{
  "version": 1,
  "modules": [
    {
      "id": "receiver-channel-pool",
      "groups": [
        {
          "title": "Channel allocation",
          "topic": "receiver",
          "note": "Choose total channels and reservations. Fixed 6 GPS + 4 Galileo: total 10, GPS 6, Galileo 4. Automatic pool: total 12, both reservations 0. Preference applies when confirmed results compete for shared capacity.",
          "fields": [
            {
              "key": "receiver.channels",
              "label": "Total receiver channels",
              "type": "number",
              "default": 16,
              "integer": true,
              "min": 1,
              "max": 64
            },
            {
              "key": "receiver.gps_reserved",
              "label": "Slots reserved for GPS",
              "type": "number",
              "default": 0,
              "integer": true,
              "min": 0,
              "max": 32
            },
            {
              "key": "receiver.galileo_reserved",
              "label": "Slots reserved for Galileo",
              "type": "number",
              "default": 0,
              "integer": true,
              "min": 0,
              "max": 32
            },
            {
              "key": "receiver.auto_priority",
              "label": "Automatic channel preference",
              "type": "select",
              "default": "0",
              "options": [
                {
                  "value": "0",
                  "label": "First confirmed"
                },
                {
                  "value": "1",
                  "label": "Prefer GPS"
                },
                {
                  "value": "2",
                  "label": "Prefer Galileo"
                }
              ]
            }
          ]
        }
      ],
      "rules": [
        {
          "kind": "sumAtMost",
          "keys": [
            "receiver.channels",
            "receiver.gps_reserved",
            "receiver.galileo_reserved"
          ],
          "left": "receiver.gps_reserved",
          "right": "receiver.galileo_reserved",
          "total": "receiver.channels",
          "message": "GPS and Galileo reservations must fit within the total receiver channels."
        }
      ]
    },
    {
      "id": "classic-tracking",
      "rules": [],
      "groups": [
        {
          "title": "Tracking correlators",
          "topic": "tracking",
          "note": "GPS 1 ms / Galileo E1-B BOC(1,1) 4 ms. Extra taps observe the shape; DLL uses the adjacent E/L pair. Square carrier is approximate and introduces harmonic images.",
          "fields": [
            {
              "key": "tracking.workers",
              "label": "Total tracking worker pool",
              "type": "number",
              "default": 4,
              "integer": true,
              "min": 1,
              "max": 16
            },
            {
              "key": "tracking.tap_count",
              "label": "Tap count (odd)",
              "type": "number",
              "default": 3,
              "integer": true,
              "min": 3,
              "max": 33,
              "step": 2
            },
            {
              "key": "tracking.spacing_chips",
              "label": "GPS adjacent tap spacing (chips)",
              "type": "number",
              "default": 0.4,
              "min": 0.001,
              "max": 1,
              "step": 0.01
            },
            {
              "key": "tracking.galileo_spacing_slots",
              "label": "Galileo adjacent tap spacing (slots, ? chip)",
              "type": "number",
              "default": 0.4,
              "min": 0.002,
              "max": 0.666666666,
              "exclusiveMax": true,
              "step": 0.01
            }
          ]
        }
      ]
    },
    {
      "id": "tracking-doppler-smoothing",
      "groups": [
        {
          "title": "Tracking Doppler smoothing",
          "topic": "tracking",
          "note": "The tracking output Doppler is low-pass filtered before PVT. The carrier loop itself is unchanged; reacquisition resets the filter.",
          "fields": [
            {
              "key": "tracking.doppler_smoothing_ms",
              "label": "Doppler smoothing time (ms)",
              "type": "number",
              "default": 200,
              "integer": true,
              "min": 0,
              "max": 10000,
              "hint": "Zero disables smoothing; the setting applies to tracking observations."
            }
          ]
        }
      ],
      "rules": []
    },
    {
      "id": "gps-l1-ca-classic",
      "groups": [
        {
          "title": "GPS acquisition",
          "topic": "acquisition",
          "note": "GPS L1 C/A: coarse ±5 kHz / 667 Hz, eight 1-ms periods, Doppler refinement 10 Hz, native-sample code refinement, confirmation 3 of 4. Tracking has separate operational settings.",
          "fields": [
            {
              "key": "acquisition.first_prn",
              "label": "First GPS PRN",
              "type": "number",
              "default": 1,
              "integer": true,
              "min": 1,
              "max": 32
            },
            {
              "key": "acquisition.cpu_budget",
              "label": "Acquisition CPU budget (cores per signal second)",
              "type": "number",
              "default": 1,
              "min": 0,
              "max": 32,
              "step": 0.1,
              "hint": "Shared by GPS and Galileo. Zero restores the previous adaptive admission policy; this changes scheduling, not search decisions."
            },
            {
              "key": "acquisition.pfa",
              "label": "GPS false alarm probability per cell",
              "type": "number",
              "default": 1e-9,
              "min": 1e-15,
              "max": 0.01,
              "step": 1e-9,
              "hint": "This directly changes the GPS detection threshold."
            },
            {
              "key": "acquisition.last_prn",
              "label": "Last GPS PRN",
              "type": "number",
              "default": 32,
              "integer": true,
              "min": 1,
              "max": 32
            }
          ]
        }
      ],
      "rules": [
        {
          "kind": "lessEqual",
          "keys": [
            "acquisition.first_prn",
            "acquisition.last_prn"
          ],
          "left": "acquisition.first_prn",
          "right": "acquisition.last_prn",
          "message": "First GPS PRN must not exceed last GPS PRN."
        }
      ]
    },
    {
      "id": "galileo-e1b-classic",
      "groups": [
        {
          "title": "Galileo acquisition",
          "topic": "acquisition",
          "note": "Galileo E1-B: coarse 87 Hz, eight 4-ms periods, Doppler/code refinement, confirmation 3 of 4. BOC(1,1) replica; tracking is not integrated.",
          "fields": [
            {
              "key": "galileo_acquisition.first_prn",
              "label": "First Galileo PRN",
              "type": "number",
              "default": 1,
              "integer": true,
              "min": 1,
              "max": 32
            },
            {
              "key": "galileo_acquisition.fft_size",
              "label": "Galileo coarse FFT size",
              "type": "select",
              "default": "0",
              "options": [
                {
                  "value": "0",
                  "label": "Automatic"
                },
                {
                  "value": "4096",
                  "label": "4096 (changes search algorithm)"
                },
                {
                  "value": "8192",
                  "label": "8192"
                },
                {
                  "value": "16384",
                  "label": "16384"
                }
              ],
              "hint": "16384 requires an effective stream rate of at least 4.096 Msps, including replay metadata. Automatic uses 8192 below that rate. 4096 uses fixed-phase subcarrier removal and missed synthetic satellites in the profiling report."
            },
            {
              "key": "galileo_acquisition.pfa",
              "label": "Galileo false alarm probability per cell",
              "type": "number",
              "default": 1e-9,
              "min": 1e-15,
              "max": 0.01,
              "step": 1e-9,
              "hint": "This directly changes the Galileo detection threshold."
            },
            {
              "key": "galileo_acquisition.last_prn",
              "label": "Last Galileo PRN",
              "type": "number",
              "default": 32,
              "integer": true,
              "min": 1,
              "max": 32
            }
          ]
        }
      ],
      "rules": [
        {
          "kind": "lessEqual",
          "keys": [
            "galileo_acquisition.first_prn",
            "galileo_acquisition.last_prn"
          ],
          "left": "galileo_acquisition.first_prn",
          "right": "galileo_acquisition.last_prn",
          "message": "First Galileo PRN must not exceed last Galileo PRN."
        }
      ]
    },
    {
      "id": "dsp-arithmetic",
      "groups": [
        {
          "title": "DSP Arithmetic",
          "topic": "dsp",
          "note": "Arithmetic choices for acquisition and tracking. Integer FFT modes restore float-domain scaling before search decisions.",
          "fields": [
            {
              "key": "dsp.tracking_fast_carrier",
              "label": "Four-lane carrier recurrence (CI8)",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Disabled"
                },
                {
                  "value": "true",
                  "label": "Enabled (double arithmetic)"
                }
              ],
              "hint": "Only affects CI8 tracking. This is not an integer carrier implementation."
            },
            {
              "key": "dsp.tracking_square_carrier",
              "label": "Carrier rotation",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Precise sinusoidal"
                },
                {
                  "value": "true",
                  "label": "Fast square (experimental)"
                }
              ]
            },
            {
              "key": "dsp.tracking_xor_correlation",
              "label": "Correlation product",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Precise SIMD products"
                },
                {
                  "value": "true",
                  "label": "Fast exact sign XOR"
                }
              ]
            },
            {
              "key": "dsp.gps_square_carrier",
              "label": "Local carrier",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Sinusoidal"
                },
                {
                  "value": "true",
                  "label": "Squared sin/cos"
                }
              ]
            },
            {
              "key": "dsp.gps_xor_correlation",
              "label": "Code correlation",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "SIMD products"
                },
                {
                  "value": "true",
                  "label": "SIMD sign XOR"
                }
              ],
              "hint": "XOR reverses the sign for ±1 code chips and preserves ADC amplitudes."
            },
            {
              "key": "dsp.galileo_square_carrier",
              "label": "Local carrier",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Sinusoidal"
                },
                {
                  "value": "true",
                  "label": "Squared sin/cos"
                }
              ]
            },
            {
              "key": "dsp.galileo_xor_correlation",
              "label": "Code correlation",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "SIMD products"
                },
                {
                  "value": "true",
                  "label": "SIMD sign XOR"
                }
              ],
              "hint": "XOR reverses the sign for ±1 code chips and preserves ADC amplitudes."
            },
            {
              "key": "dsp.tracking_mixer_bits",
              "label": "Tracking mixer result width",
              "type": "select",
              "default": "0",
              "options": [
                {
                  "value": "0",
                  "label": "Precise floating point"
                },
                {
                  "value": "16",
                  "label": "8-bit ? 8-bit, signed 16-bit products"
                },
                {
                  "value": "8",
                  "label": "8-bit ? 8-bit, rounded 8-bit output"
                },
                {
                  "value": "4",
                  "label": "Input shifted to 4-bit, signed 8-bit products"
                }
              ],
              "hint": "Byte modes require a CI8 common stream. Quantized carrier may reduce PVT accuracy."
            },
            {
              "key": "dsp.gps_fft",
              "label": "GPS coarse FFT arithmetic",
              "type": "select",
              "default": "float",
              "options": [
                {
                  "value": "float",
                  "label": "Float SIMD"
                },
                {
                  "value": "integer_precise",
                  "label": "Integer precise (unscaled int32)"
                },
                {
                  "value": "integer_scaled",
                  "label": "Integer Q14 (stage rescaled SIMD)"
                }
              ],
              "hint": "FFT scale is restored before power and threshold calculations."
            },
            {
              "key": "dsp.galileo_fft",
              "label": "Galileo coarse FFT arithmetic",
              "type": "select",
              "default": "float",
              "options": [
                {
                  "value": "float",
                  "label": "Float SIMD"
                },
                {
                  "value": "integer_precise",
                  "label": "Integer precise (unscaled int32)"
                },
                {
                  "value": "integer_scaled",
                  "label": "Integer Q14 (stage rescaled SIMD)"
                }
              ],
              "hint": "FFT scale is restored before power and threshold calculations."
            },
            {
              "key": "dsp.spectrum_fft",
              "label": "Spectrum FFT arithmetic",
              "type": "select",
              "default": "integer_scaled",
              "options": [
                {
                  "value": "float",
                  "label": "Float SIMD"
                },
                {
                  "value": "integer_precise",
                  "label": "Integer precise (unscaled int32)"
                },
                {
                  "value": "integer_scaled",
                  "label": "Integer Q14 (stage rescaled SIMD)"
                }
              ],
              "hint": "Spectrum display only; does not affect acquisition or PVT."
            }
          ]
        }
      ],
      "rules": []
    }
  ],
