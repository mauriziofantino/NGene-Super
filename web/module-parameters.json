{
  "version": 1,
  "modules": [
    {
      "id": "gps_l1_ca_ngene",
      "groups": [
        {
          "id": "gps_receiver",
          "topic": "receiver",
          "title": "GPS receiver",
          "fields": [
            {
              "key": "acquisition.enabled",
              "label": "GPS L1 C/A acquisition",
              "type": "select",
              "options": [
                {
                  "value": "false",
                  "label": "Off"
                },
                {
                  "value": "true",
                  "label": "On"
                }
              ],
              "hint": "Starts with the receiver; Galileo acquisition and tracking are not integrated."
            },
            {
              "key": "acquisition.gps_channels",
              "label": "Concurrent GPS searches",
              "type": "number",
              "unit": "channels",
              "hint": "Independent acquisition contexts; OS schedules up to four workers.",
              "min": 1,
              "max": 32,
              "integer": true
            },
            {
              "key": "acquisition.gps_prn_mask",
              "label": "GPS PRN selection mask",
              "type": "number",
              "hint": "4294967295 selects PRNs 1–32. Bit 0 selects PRN 1, bit 31 selects PRN 32.",
              "min": 0,
              "max": 4294967295,
              "integer": true
            }
          ]
        },
        {
          "id": "gps_methods",
          "topic": "acquisition",
          "title": "Acquisition strategy",
          "note": "Search, detection and confirmation are independent choices. This build uses NGene compressed FFT correlation with 1 ms coherent periods. Detection probability depends on signal strength and integration; it is not an independent setting.",
          "fields": [
            {
              "key": "acquisition.search_method",
              "label": "Coarse search",
              "type": "select",
              "default": "ngene_fft",
              "options": [
                {
                  "value": "ngene_fft",
                  "label": "NGene compressed FFT"
                }
              ],
              "hint": "FFT correlates code delays in parallel; Doppler bins are searched sequentially. Other search engines require a registered receiver module."
            },
            {
              "key": "acquisition.detector",
              "label": "Coarse detector",
              "type": "select",
              "default": "pfa",
              "options": [
                {
                  "value": "pfa",
                  "label": "Threshold from false-alarm probability"
                }
              ],
              "hint": "Bayesian detectors are not implemented in this build."
            }
          ]
        },
        {
          "id": "gps_coarse",
          "topic": "acquisition",
          "title": "GPS acquisition",
          "fields": [
            {
              "key": "acquisition.fft_size",
              "label": "Maximum coarse FFT size",
              "type": "select",
              "options": [
                {
                  "value": "8",
                  "label": "8"
                },
                {
                  "value": "16",
                  "label": "16"
                },
                {
                  "value": "32",
                  "label": "32"
                },
                {
                  "value": "64",
                  "label": "64"
                },
                {
                  "value": "128",
                  "label": "128"
                },
                {
                  "value": "256",
                  "label": "256"
                },
                {
                  "value": "512",
                  "label": "512"
                },
                {
                  "value": "1024",
                  "label": "1024"
                },
                {
                  "value": "2048",
                  "label": "2048"
                },
                {
                  "value": "4096",
                  "label": "4096"
                },
                {
                  "value": "8192",
                  "label": "8192"
                },
                {
                  "value": "16384",
                  "label": "16384"
                }
              ],
              "unit": "points",
              "hint": "NGene accumulation/compression; automatically reduced when fewer input samples are available."
            },
            {
              "key": "acquisition.doppler_max_hz",
              "label": "Doppler search half-width",
              "type": "number",
              "unit": "Hz",
              "min": 0,
              "max": 100000,
              "integer": false
            },
            {
              "key": "acquisition.doppler_step_hz",
              "label": "Doppler search step",
              "type": "number",
              "unit": "Hz",
              "min": 0,
              "integer": false,
              "exclusiveMin": true
            },
            {
              "key": "acquisition.code_step_chips",
              "label": "Supplementary code delay step",
              "type": "number",
              "unit": "chip",
              "min": 0,
              "max": 1023,
              "integer": false,
              "exclusiveMin": true
            },
            {
              "key": "acquisition.false_alarm_probability",
              "label": "False alarm probability per cell",
              "type": "number",
              "min": 1e-15,
              "max": 1,
              "integer": false,
              "exclusiveMax": true,
              "hint": "Nominal probability for one tested cell under the white-noise reference model, not for the full PRN/Doppler search or arbitrary interference."
            },
            {
              "key": "acquisition.noncoherent_sums",
              "label": "Maximum noncoherent sums",
              "type": "number",
              "unit": "1 ms periods",
              "min": 1,
              "max": 1024,
              "integer": true
            }
          ]
        },
        {
          "id": "gps_refinement",
          "topic": "acquisition",
          "title": "Acquisition refinement",
          "fields": [
            {
              "key": "acquisition.refinement_doppler_span_hz",
              "label": "Doppler refinement half-width",
              "type": "number",
              "unit": "Hz",
              "min": 0,
              "max": 100000,
              "integer": false
            },
            {
              "key": "acquisition.refinement_doppler_step_hz",
              "label": "Doppler refinement step",
              "type": "number",
              "unit": "Hz",
              "min": 0,
              "integer": false,
              "exclusiveMin": true
            },
            {
              "key": "acquisition.refinement_code_span_chips",
              "label": "Code refinement half-width",
              "type": "number",
              "unit": "chip",
              "min": 0,
              "max": 16,
              "integer": false
            },
            {
              "key": "acquisition.refinement_code_step_samples",
              "label": "Code refinement step",
              "type": "number",
              "unit": "samples",
              "min": 1,
              "max": 4294967295,
              "integer": true
            }
          ]
        },
        {
          "id": "gps_confirmation",
          "topic": "acquisition",
          "title": "Optional confirmation",
          "note": "None accepts the coarse detection after Doppler/code refinement. M-of-N checks fresh signal periods. TONG is not implemented.",
          "fields": [
            {
              "key": "acquisition.confirmation",
              "label": "Confirmation method",
              "type": "select",
              "default": "m_of_n",
              "options": [
                {
                  "value": "none",
                  "label": "None"
                },
                {
                  "value": "m_of_n",
                  "label": "M-of-N"
                }
              ]
            },
            {
              "key": "acquisition.confirmation_attempts",
              "label": "Confirmation attempts (N)",
              "type": "number",
              "min": 1,
              "max": 1024,
              "integer": true,
              "visibleWhen": {
                "acquisition.confirmation": "m_of_n"
              }
            },
            {
              "key": "acquisition.confirmation_successes",
              "label": "Required confirmation successes (M)",
              "type": "number",
              "min": 1,
              "max": 1024,
              "integer": true,
              "visibleWhen": {
                "acquisition.confirmation": "m_of_n"
              }
            }
          ]
        }
      ],
      "rules": [
        {
          "keys": [
            "acquisition.confirmation_successes",
            "acquisition.confirmation_attempts"
          ],
          "when": {
            "acquisition.confirmation": "m_of_n"
          },
          "kind": "lessEqual",
          "left": "acquisition.confirmation_successes",
          "right": "acquisition.confirmation_attempts",
          "message": "Confirmation requires M successes to be no greater than N attempts."
        },
        {
          "keys": [
            "acquisition.code_step_chips"
          ],
          "kind": "ratioLess",
          "numerator": 1023,
          "denominator": "acquisition.code_step_chips",
          "limit": 65536,
          "message": "The delay grid must have fewer than 65536 positions."
        },
        {
          "keys": [
            "acquisition.doppler_max_hz",
            "acquisition.doppler_step_hz"
          ],
          "kind": "ratioLess",
          "numerator": "acquisition.doppler_max_hz",
          "scale": 2,
          "denominator": "acquisition.doppler_step_hz",
          "limit": 65536,
          "message": "The Doppler grid must have fewer than 65536 positions."
        },
        {
          "keys": [
            "acquisition.refinement_doppler_span_hz",
            "acquisition.refinement_doppler_step_hz"
          ],
          "kind": "ratioLess",
          "numerator": "acquisition.refinement_doppler_span_hz",
          "scale": 2,
          "denominator": "acquisition.refinement_doppler_step_hz",
          "limit": 65536,
          "message": "The Doppler grid must have fewer than 65536 positions."
        },
        {
          "keys": [
            "frontend.sample_rate_hz"
          ],
          "when": {
            "acquisition.enabled": "true"
          },
          "kind": "minimum",
          "key": "frontend.sample_rate_hz",
          "value": 1023000,
          "message": "GPS acquisition requires at least 1023000 complex samples/s."
        },
        {
          "keys": [
            "acquisition.gps_prn_mask"
          ],
          "when": {
            "acquisition.enabled": "true"
          },
          "kind": "minimum",
          "key": "acquisition.gps_prn_mask",
          "value": 1,
          "message": "Select at least one GPS PRN while acquisition is enabled."
        }
      ]
    }
  ],
