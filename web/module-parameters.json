{
  "version": 1,
  "modules": [
    {
      "id": "receiver-channel-pool",
      "groups": [
        {
          "title": "Channel allocation",
          "topic": "receiver",
          "note": "Reserve slots per constellation or leave them shared. Preference resolves competition for shared slots.",
          "fields": [
            {
              "key": "receiver.channels",
              "label": "Total receiver channels",
              "type": "number",
              "default": 16,
              "integer": true,
              "min": 1,
              "max": 64
            },
            {
              "key": "receiver.gps_reserved",
              "label": "Slots reserved for GPS",
              "type": "number",
              "default": 0,
              "integer": true,
              "min": 0,
              "max": 32
            },
            {
              "key": "receiver.galileo_reserved",
              "label": "Slots reserved for Galileo",
              "type": "number",
              "default": 0,
              "integer": true,
              "min": 0,
              "max": 32
            },
            {
              "key": "receiver.beidou_reserved",
              "label": "Slots reserved for BeiDou",
              "type": "number",
              "default": 0,
              "integer": true,
              "min": 0,
              "max": 63
            },
            {
              "key": "receiver.auto_priority",
              "label": "Automatic channel preference",
              "type": "select",
              "default": "0",
              "options": [
                {
                  "value": "0",
                  "label": "First confirmed"
                },
                {
                  "value": "1",
                  "label": "Prefer GPS"
                },
                {
                  "value": "2",
                  "label": "Prefer Galileo"
                },
                {
                  "value": "3",
                  "label": "Prefer BeiDou"
                }
              ]
            }
          ]
        }
      ],
      "rules": [
        {
          "kind": "sumAtMost",
          "keys": [
            "receiver.channels",
            "receiver.gps_reserved",
            "receiver.galileo_reserved",
            "receiver.beidou_reserved"
          ],
          "left": "receiver.gps_reserved",
          "right": "receiver.galileo_reserved",
          "extra": "receiver.beidou_reserved",
          "total": "receiver.channels",
          "message": "Constellation reservations must fit within the total receiver channels."
        }
      ]
    },
    {
      "id": "classic-tracking",
      "rules": [],
      "groups": [
        {
          "title": "Tracking correlators",
          "topic": "tracking",
          "note": "GPS and EGNOS integrate over 1 ms, Galileo E1-B over 4 ms and BeiDou B1C over 10 ms. The DLL uses the adjacent early and late taps.",
          "fields": [
            {
              "key": "tracking.workers",
              "label": "Total tracking worker pool",
              "type": "number",
              "default": 4,
              "integer": true,
              "min": 1,
              "max": 16
            },
            {
              "key": "tracking.tap_count",
              "label": "Tap count (odd)",
              "type": "number",
              "default": 3,
              "integer": true,
              "min": 3,
              "max": 33,
              "step": 2
            },
            {
              "key": "tracking.spacing_chips",
              "label": "GPS adjacent tap spacing (chips)",
              "type": "number",
              "default": 0.4,
              "min": 0.001,
              "max": 1,
              "step": 0.01
            },
            {
              "key": "tracking.galileo_spacing_slots",
              "label": "Galileo adjacent tap spacing (half-chip slots)",
              "type": "number",
              "default": 0.4,
              "min": 0.002,
              "max": 0.666666666,
              "exclusiveMax": true,
              "step": 0.01
            },
            {
              "key": "tracking.beidou_spacing_chips",
              "label": "BeiDou B1C adjacent tap spacing (chips)",
              "type": "number",
              "default": 0,
              "min": 0,
              "max": 0.3333333333333333,
              "exclusiveMax": true,
              "hint": "Zero uses the Galileo spacing. Enter a positive spacing to configure BeiDou independently."
            },
            {
              "key": "tracking.egnos_spacing_chips",
              "label": "EGNOS adjacent tap spacing (chips)",
              "type": "number",
              "default": 0.4,
              "min": 0.001,
              "max": 1
            }
          ]
        },
        {
          "title": "Tracking carrier and correlation",
          "topic": "tracking",
          "fields": [
            {
              "key": "dsp.tracking_fast_carrier",
              "label": "Four-lane carrier recurrence (CI8)",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Disabled"
                },
                {
                  "value": "true",
                  "label": "Enabled (double arithmetic)"
                }
              ],
              "hint": "Only affects CI8 tracking. This is not an integer carrier implementation."
            },
            {
              "key": "dsp.tracking_square_carrier",
              "label": "Carrier rotation",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Precise sinusoidal"
                },
                {
                  "value": "true",
                  "label": "Square carrier"
                }
              ],
              "hint": "C/N0 uses a sinusoidal reference prompt with square or quantized tracking mixers."
            },
            {
              "key": "dsp.tracking_xor_correlation",
              "label": "Correlation product",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Precise SIMD products"
                },
                {
                  "value": "true",
                  "label": "Fast exact sign XOR"
                }
              ]
            },
            {
              "key": "dsp.tracking_mixer_bits",
              "label": "Tracking mixer result width",
              "type": "select",
              "default": "0",
              "options": [
                {
                  "value": "0",
                  "label": "Precise floating point"
                },
                {
                  "value": "16",
                  "label": "8-bit ? 8-bit, signed 16-bit products"
                },
                {
                  "value": "8",
                  "label": "8-bit ? 8-bit, rounded 8-bit output"
                },
                {
                  "value": "4",
                  "label": "Input shifted to 4-bit, signed 8-bit products"
                }
              ],
              "hint": "Byte modes require a CI8 common stream. Quantized carrier may reduce PVT accuracy."
            }
          ]
        },
        {
          "title": "GPS loop filters",
          "topic": "tracking",
          "note": "Coefficients are recalculated for the coherent period when the channel is assigned.",
          "fields": [
            {
              "key": "tracking.gps_dll_bandwidth_hz",
              "label": "DLL bandwidth (Hz)",
              "type": "number",
              "default": 2,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.gps_dll_gain",
              "label": "DLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            },
            {
              "key": "tracking.gps_fll_bandwidth_hz",
              "label": "FLL bandwidth (Hz)",
              "type": "number",
              "default": 15,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.gps_fll_gain",
              "label": "FLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            },
            {
              "key": "tracking.gps_pll_bandwidth_hz",
              "label": "PLL bandwidth (Hz)",
              "type": "number",
              "default": 15,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.gps_pll_gain",
              "label": "PLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            }
          ]
        },
        {
          "title": "Galileo loop filters",
          "topic": "tracking",
          "note": "Coefficients are recalculated for the coherent period when the channel is assigned.",
          "fields": [
            {
              "key": "tracking.galileo_dll_bandwidth_hz",
              "label": "DLL bandwidth (Hz)",
              "type": "number",
              "default": 2,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.galileo_dll_gain",
              "label": "DLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            },
            {
              "key": "tracking.galileo_fll_bandwidth_hz",
              "label": "FLL bandwidth (Hz)",
              "type": "number",
              "default": 15,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.galileo_fll_gain",
              "label": "FLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            },
            {
              "key": "tracking.galileo_pll_bandwidth_hz",
              "label": "PLL bandwidth (Hz)",
              "type": "number",
              "default": 15,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.galileo_pll_gain",
              "label": "PLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            }
          ]
        },
        {
          "title": "BeiDou B1C loop filters",
          "topic": "tracking",
          "note": "BeiDou scales its 10-ms loop coefficients relative to the nominal bandwidth settings.",
          "fields": [
            {
              "key": "tracking.beidou_dll_bandwidth_hz",
              "label": "DLL bandwidth (Hz)",
              "type": "number",
              "default": 2,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.beidou_dll_gain",
              "label": "DLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            },
            {
              "key": "tracking.beidou_fll_bandwidth_hz",
              "label": "FLL bandwidth (Hz)",
              "type": "number",
              "default": 15,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.beidou_fll_gain",
              "label": "FLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            },
            {
              "key": "tracking.beidou_pll_bandwidth_hz",
              "label": "PLL bandwidth (Hz)",
              "type": "number",
              "default": 15,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.beidou_pll_gain",
              "label": "PLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            }
          ]
        },
        {
          "title": "EGNOS loop filters",
          "topic": "tracking",
          "note": "Coefficients are recalculated for the coherent period when the channel is assigned.",
          "fields": [
            {
              "key": "tracking.egnos_dll_bandwidth_hz",
              "label": "DLL bandwidth (Hz)",
              "type": "number",
              "default": 2,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.egnos_dll_gain",
              "label": "DLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            },
            {
              "key": "tracking.egnos_fll_bandwidth_hz",
              "label": "FLL bandwidth (Hz)",
              "type": "number",
              "default": 15,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.egnos_fll_gain",
              "label": "FLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            },
            {
              "key": "tracking.egnos_pll_bandwidth_hz",
              "label": "PLL bandwidth (Hz)",
              "type": "number",
              "default": 15,
              "min": 0.1,
              "max": 50
            },
            {
              "key": "tracking.egnos_pll_gain",
              "label": "PLL gain",
              "type": "number",
              "default": 1,
              "min": 0.1,
              "max": 20
            }
          ]
        },
        {
          "title": "FLL to PLL transition",
          "topic": "tracking",
          "note": "Applies to GPS, Galileo and EGNOS. BeiDou uses its B1C transition logic.",
          "fields": [
            {
              "key": "tracking.fll_decision_updates",
              "label": "FLL / PLL decision filter length (updates)",
              "type": "number",
              "default": 20,
              "integer": true,
              "min": 1,
              "max": 1000
            },
            {
              "key": "tracking.fll_decision_interval_ms",
              "label": "FLL / PLL decision interval (ms)",
              "type": "number",
              "default": 100,
              "integer": true,
              "min": 4,
              "max": 2000
            },
            {
              "key": "tracking.fll_transition_hz",
              "label": "FLL / PLL transition threshold (Hz)",
              "type": "number",
              "default": 1,
              "min": 0.01,
              "max": 100
            }
          ]
        },
        {
          "title": "Lock quality",
          "topic": "tracking",
          "fields": [
            {
              "key": "tracking.cn0_cutoff_db_hz",
              "label": "C/N0 cutoff (dB-Hz)",
              "type": "number",
              "default": 0,
              "min": 0,
              "max": 60,
              "hint": "Zero disables the cutoff. With a valid estimate, sustained low C/N0 releases the channel."
            }
          ]
        },
        {
          "title": "GPS coherent loop integration",
          "topic": "tracking",
          "note": "Pull-in and LNAV use 1 ms prompts. The configured PLL and DLL interval starts after bit synchronization.",
          "fields": [
            {
              "key": "tracking.gps_coherent_ms",
              "label": "GPS coherent loop integration (ms)",
              "type": "select",
              "default": "1",
              "options": [
                {
                  "value": "1",
                  "label": "1"
                },
                {
                  "value": "2",
                  "label": "2"
                },
                {
                  "value": "4",
                  "label": "4"
                },
                {
                  "value": "5",
                  "label": "5"
                },
                {
                  "value": "10",
                  "label": "10"
                },
                {
                  "value": "20",
                  "label": "20"
                }
              ]
            },
            {
              "key": "tracking.gps_transition_checks",
              "label": "GPS bit synchronization transition checks",
              "type": "number",
              "default": 5,
              "min": 1,
              "max": 100,
              "integer": true
            }
          ]
        }
      ]
    },
    {
      "id": "tracking-doppler-smoothing",
      "groups": [
        {
          "title": "Tracking Doppler smoothing",
          "topic": "tracking",
          "note": "The tracking output Doppler is low-pass filtered before PVT. The carrier loop itself is unchanged; reacquisition resets the filter.",
          "fields": [
            {
              "key": "tracking.doppler_smoothing_ms",
              "label": "Doppler smoothing time (ms)",
              "type": "number",
              "default": 200,
              "integer": true,
              "min": 0,
              "max": 10000,
              "hint": "Zero disables smoothing; the setting applies to tracking observations."
            }
          ]
        }
      ],
      "rules": []
    },
    {
      "id": "pvt-broadcast-ionosphere",
      "groups": [
        {
          "title": "Ionospheric corrections",
          "topic": "navigation",
          "fields": [
            {
              "key": "navigation.broadcast_ionosphere",
              "label": "Broadcast ionosphere correction",
              "type": "select",
              "default": "true",
              "options": [
                {
                  "value": "true",
                  "label": "Enabled"
                },
                {
                  "value": "false",
                  "label": "Disabled"
                }
              ]
            }
          ]
        }
      ],
      "rules": []
    },
    {
      "id": "receiver-egnos",
      "groups": [
        {
          "title": "SBAS constellation",
          "topic": "receiver",
          "note": "Enable the EGNOS L1 GEO channel. It appears in Channels as auxiliary channel 65.",
          "fields": [
            {
              "key": "receiver.egnos",
              "label": "EGNOS L1",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Disabled"
                },
                {
                  "value": "true",
                  "label": "Receive from GEO"
                }
              ]
            }
          ]
        }
      ],
      "rules": []
    },
    {
      "id": "gps-l1-ca-classic",
      "groups": [
        {
          "title": "GPS acquisition",
          "topic": "acquisition",
          "note": "GPS L1 C/A: coarse ±5 kHz / 667 Hz, eight 1-ms periods, Doppler refinement 10 Hz, native-sample code refinement, confirmation 3 of 4. Tracking has separate operational settings.",
          "fields": [
            {
              "key": "acquisition.first_prn",
              "label": "First GPS PRN",
              "type": "number",
              "default": 1,
              "integer": true,
              "min": 1,
              "max": 32
            },
            {
              "key": "acquisition.cpu_budget",
              "label": "Acquisition CPU budget (cores per signal second)",
              "type": "number",
              "default": 1,
              "min": 0,
              "max": 32,
              "step": 0.1,
              "hint": "Shared by GPS and Galileo. Zero restores the previous adaptive admission policy; this changes scheduling, not search decisions."
            },
            {
              "key": "acquisition.pfa",
              "label": "GPS false alarm probability per cell",
              "type": "number",
              "default": 1e-9,
              "min": 1e-15,
              "max": 0.01,
              "step": 1e-9,
              "hint": "This directly changes the GPS detection threshold."
            },
            {
              "key": "acquisition.last_prn",
              "label": "Last GPS PRN",
              "type": "number",
              "default": 32,
              "integer": true,
              "min": 1,
              "max": 32
            },
            {
              "key": "dsp.gps_square_carrier",
              "label": "Local carrier",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Sinusoidal"
                },
                {
                  "value": "true",
                  "label": "Squared sin/cos"
                }
              ]
            },
            {
              "key": "dsp.gps_xor_correlation",
              "label": "Code correlation",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "SIMD products"
                },
                {
                  "value": "true",
                  "label": "SIMD sign XOR"
                }
              ],
              "hint": "XOR reverses the sign for ±1 code chips and preserves ADC amplitudes."
            },
            {
              "key": "dsp.gps_fft",
              "label": "GPS coarse FFT arithmetic",
              "type": "select",
              "default": "float",
              "options": [
                {
                  "value": "float",
                  "label": "Float SIMD"
                },
                {
                  "value": "integer_precise",
                  "label": "Integer precise (unscaled int32)"
                },
                {
                  "value": "integer_scaled",
                  "label": "Integer Q14 (stage rescaled SIMD)"
                }
              ],
              "hint": "FFT scale is restored before power and threshold calculations."
            }
          ]
        }
      ],
      "rules": [
        {
          "kind": "lessEqual",
          "keys": [
            "acquisition.first_prn",
            "acquisition.last_prn"
          ],
          "left": "acquisition.first_prn",
          "right": "acquisition.last_prn",
          "message": "First GPS PRN must not exceed last GPS PRN."
        }
      ]
    },
    {
      "id": "galileo-e1b-classic",
      "groups": [
        {
          "title": "Galileo acquisition",
          "topic": "acquisition",
          "note": "Galileo E1-B uses a BOC(1,1) replica, Doppler and code refinement, and 3-of-4 confirmation.",
          "fields": [
            {
              "key": "galileo_acquisition.first_prn",
              "label": "First Galileo PRN",
              "type": "number",
              "default": 1,
              "integer": true,
              "min": 1,
              "max": 32
            },
            {
              "key": "galileo_acquisition.fft_size",
              "label": "Galileo coarse FFT size",
              "type": "select",
              "default": "0",
              "options": [
                {
                  "value": "0",
                  "label": "Automatic"
                },
                {
                  "value": "4096",
                  "label": "4096 (changes search algorithm)"
                },
                {
                  "value": "8192",
                  "label": "8192"
                },
                {
                  "value": "16384",
                  "label": "16384"
                }
              ],
              "hint": "16384 requires an effective stream rate of at least 4.096 Msps, including replay metadata. Automatic uses 8192 below that rate. 4096 uses fixed-phase subcarrier removal and missed synthetic satellites in the profiling report."
            },
            {
              "key": "galileo_acquisition.pfa",
              "label": "Galileo false alarm probability per cell",
              "type": "number",
              "default": 1e-9,
              "min": 1e-15,
              "max": 0.01,
              "step": 1e-9,
              "hint": "This directly changes the Galileo detection threshold."
            },
            {
              "key": "galileo_acquisition.last_prn",
              "label": "Last Galileo PRN",
              "type": "number",
              "default": 32,
              "integer": true,
              "min": 1,
              "max": 32
            },
            {
              "key": "dsp.galileo_square_carrier",
              "label": "Local carrier",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "Sinusoidal"
                },
                {
                  "value": "true",
                  "label": "Squared sin/cos"
                }
              ]
            },
            {
              "key": "dsp.galileo_xor_correlation",
              "label": "Code correlation",
              "type": "select",
              "default": "false",
              "options": [
                {
                  "value": "false",
                  "label": "SIMD products"
                },
                {
                  "value": "true",
                  "label": "SIMD sign XOR"
                }
              ],
              "hint": "XOR reverses the sign for ±1 code chips and preserves ADC amplitudes."
            },
            {
              "key": "dsp.galileo_fft",
              "label": "Galileo coarse FFT arithmetic",
              "type": "select",
              "default": "float",
              "options": [
                {
                  "value": "float",
                  "label": "Float SIMD"
                },
                {
                  "value": "integer_precise",
                  "label": "Integer precise (unscaled int32)"
                },
                {
                  "value": "integer_scaled",
                  "label": "Integer Q14 (stage rescaled SIMD)"
                }
              ],
              "hint": "FFT scale is restored before power and threshold calculations."
            }
          ]
        }
      ],
      "rules": [
        {
          "kind": "lessEqual",
          "keys": [
            "galileo_acquisition.first_prn",
            "galileo_acquisition.last_prn"
          ],
          "left": "galileo_acquisition.first_prn",
          "right": "galileo_acquisition.last_prn",
          "message": "First Galileo PRN must not exceed last Galileo PRN."
        }
      ]
    },
    {
      "id": "beidou-b1c",
      "groups": [
        {
          "title": "BeiDou B1C acquisition",
          "topic": "acquisition",
          "fields": [
            {
              "key": "beidou_acquisition.first_prn",
