option(NGENE_EXPERIMENTAL_Q14_AVX2 "Enable the experimental x86-64 Q14 FFT" OFF)

function(ngene_add_q14_avx2 target root)
    if(NOT NGENE_EXPERIMENTAL_Q14_AVX2)
        return()
    endif()
    if(NOT NG_TARGET_X64)
        message(FATAL_ERROR "NGENE_EXPERIMENTAL_Q14_AVX2 requires x86-64")
    endif()
    set(source "${root}/src/dsp/x86/fft_q14_avx2.c")
    target_sources(${target} PRIVATE "${source}")
    target_compile_definitions(${target} PRIVATE NGENE_EXPERIMENTAL_Q14_AVX2=1)
    if(MSVC)
        set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_OPTIONS /arch:AVX2)
    else()
        set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_OPTIONS -mavx2)
    endif()
endfunction()
