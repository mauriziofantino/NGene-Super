# Installed package, conventional prefix, or upstream build tree: never a user-specific path.
set(HACKRF_ROOT "$ENV{HACKRF_ROOT}" CACHE PATH "Optional installed HackRF prefix or upstream build directory")
set(NGENE_RUNTIME_DIRS "" CACHE STRING "Additional directories for SDK runtime dependency discovery")
find_package(HackRF CONFIG QUIET NO_MODULE HINTS "${HACKRF_ROOT}" PATH_SUFFIXES lib/cmake/HackRF HackRF)
if(TARGET HackRF::hackrf AND NOT TARGET HackRF::HackRF)
    add_library(HackRF::HackRF ALIAS HackRF::hackrf)
    get_target_property(HACKRF_INCLUDE_DIR HackRF::hackrf INTERFACE_INCLUDE_DIRECTORIES)
    set(HackRF_FOUND TRUE)
    return()
elseif(TARGET HackRF::HackRF)
    get_target_property(HACKRF_INCLUDE_DIR HackRF::HackRF INTERFACE_INCLUDE_DIRECTORIES)
    set(HackRF_FOUND TRUE)
    return()
endif()
find_path(HACKRF_INCLUDE_DIR hackrf.h HINTS "${HACKRF_ROOT}" "$ENV{HACKRF_ROOT}"
    PATH_SUFFIXES include/libhackrf include libhackrf/src ../libhackrf/src)
find_library(HACKRF_LIBRARY_RELEASE NAMES hackrf libhackrf HINTS "${HACKRF_ROOT}"
    PATH_SUFFIXES lib lib64 bin libhackrf/src/Release libhackrf/src src/Release Release)
find_library(HACKRF_LIBRARY_DEBUG NAMES hackrf libhackrf HINTS "${HACKRF_ROOT}"
    PATH_SUFFIXES debug/lib libhackrf/src/Debug src/Debug Debug NO_DEFAULT_PATH)
include(SelectLibraryConfigurations)
select_library_configurations(HACKRF)
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(HackRF REQUIRED_VARS HACKRF_INCLUDE_DIR HACKRF_LIBRARY)
if(HackRF_FOUND AND NOT TARGET HackRF::HackRF)
    if(WIN32)
        find_file(HACKRF_DLL_RELEASE NAMES hackrf.dll libhackrf.dll HINTS "${HACKRF_ROOT}"
            PATH_SUFFIXES bin libhackrf/src/Release libhackrf/src src/Release Release)
        find_file(HACKRF_DLL_DEBUG NAMES hackrf.dll libhackrf.dll HINTS "${HACKRF_ROOT}"
            PATH_SUFFIXES debug/bin libhackrf/src/Debug src/Debug Debug NO_DEFAULT_PATH)
    endif()
    if(WIN32 AND HACKRF_DLL_RELEASE)
        add_library(HackRF::HackRF SHARED IMPORTED)
        set_target_properties(HackRF::HackRF PROPERTIES
            IMPORTED_LOCATION "${HACKRF_DLL_RELEASE}" IMPORTED_IMPLIB "${HACKRF_LIBRARY_RELEASE}")
        if(HACKRF_LIBRARY_DEBUG AND HACKRF_DLL_DEBUG)
            set_target_properties(HackRF::HackRF PROPERTIES IMPORTED_LOCATION_DEBUG "${HACKRF_DLL_DEBUG}"
                IMPORTED_IMPLIB_DEBUG "${HACKRF_LIBRARY_DEBUG}")
        endif()
    else()
        add_library(HackRF::HackRF UNKNOWN IMPORTED)
        set_target_properties(HackRF::HackRF PROPERTIES IMPORTED_LOCATION "${HACKRF_LIBRARY_RELEASE}")
        if(HACKRF_LIBRARY_DEBUG)
            set_target_properties(HackRF::HackRF PROPERTIES IMPORTED_LOCATION_DEBUG "${HACKRF_LIBRARY_DEBUG}")
        endif()
    endif()
    set_target_properties(HackRF::HackRF PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${HACKRF_INCLUDE_DIR}")
endif()
mark_as_advanced(HACKRF_INCLUDE_DIR HACKRF_LIBRARY_RELEASE HACKRF_LIBRARY_DEBUG HACKRF_DLL_RELEASE HACKRF_DLL_DEBUG)
