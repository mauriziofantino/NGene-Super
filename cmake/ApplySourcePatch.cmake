# Apply the pinned RFIC dependency's unified patches using CMake only. No Unix patch
# program, Python, shell or MSYS environment is required on native Windows.
function(ngene_replace_patch_hunk path old_text new_text)
    if(old_text STREQUAL "")
        message(FATAL_ERROR "Empty source patch hunk is unsupported")
    endif()
    file(READ "${path}" content)
    string(FIND "${content}" "${old_text}" position)
    if(position LESS 0)
        message(FATAL_ERROR "Pinned RFIC patch context not found in ${path}")
    endif()
    string(LENGTH "${old_text}" old_length)
    math(EXPR end "${position} + ${old_length}")
    string(SUBSTRING "${content}" 0 ${position} before)
    string(SUBSTRING "${content}" ${end} -1 after)
    file(WRITE "${path}" "${before}${new_text}${after}")
endfunction()

function(ngene_apply_source_patch patch directory)
    file(READ "${patch}" remaining)
    set(path "")
    set(active FALSE)
    set(old_text "")
    set(new_text "")
    while(NOT remaining STREQUAL "")
        string(FIND "${remaining}" "\n" newline)
        if(newline LESS 0)
            set(line "${remaining}")
            set(remaining "")
        else()
            string(SUBSTRING "${remaining}" 0 ${newline} line)
            math(EXPR next "${newline} + 1")
            string(SUBSTRING "${remaining}" ${next} -1 remaining)
        endif()
        if(line MATCHES "^(diff |@@|--- |\\+\\+\\+ )")
            if(active)
                ngene_replace_patch_hunk("${path}" "${old_text}" "${new_text}")
            endif()
            set(active FALSE)
            set(old_text "")
            set(new_text "")
            if(line MATCHES "^\\+\\+\\+ ([^ \t]+)")
                get_filename_component(name "${CMAKE_MATCH_1}" NAME)
                if(NOT name MATCHES "^[a-zA-Z0-9_]+\\.[ch]$")
                    message(FATAL_ERROR "Unexpected pinned RFIC patch file: ${name}")
                endif()
                set(path "${directory}/${name}")
            elseif(line MATCHES "^@@")
                set(active TRUE)
            endif()
        elseif(active AND NOT line STREQUAL "")
            string(SUBSTRING "${line}" 0 1 prefix)
            string(SUBSTRING "${line}" 1 -1 text)
            if(prefix STREQUAL " " OR prefix STREQUAL "-")
                string(APPEND old_text "${text}\n")
            endif()
            if(prefix STREQUAL " " OR prefix STREQUAL "+")
                string(APPEND new_text "${text}\n")
            endif()
        endif()
    endwhile()
    if(active)
        ngene_replace_patch_hunk("${path}" "${old_text}" "${new_text}")
    endif()
endfunction()
