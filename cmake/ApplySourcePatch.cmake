# Apply the pinned RFIC dependency's unified patches using CMake only. No Unix patch
# program, Python, shell or MSYS environment is required on native Windows.
function(ngene_replace_patch_hunk path content old_text new_text result)
    if(old_text STREQUAL "")
        message(FATAL_ERROR "Empty source patch hunk is unsupported")
    endif()
    string(FIND "${content}" "${old_text}" position)
    if(position LESS 0)
        message(FATAL_ERROR "Pinned RFIC patch context not found in ${path}")
    endif()
    string(LENGTH "${old_text}" old_length)
    math(EXPR end "${position} + ${old_length}")
    string(SUBSTRING "${content}" 0 ${position} before)
    string(SUBSTRING "${content}" ${end} -1 after)
    set(${result} "${before}${new_text}${after}" PARENT_SCOPE)
endfunction()

# Do not repeatedly truncate generated sources while Windows scanners/indexers
# may hold them open. Prepare the complete patched file, then replace it atomically.
function(ngene_write_patched_source path content)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
    set(temporary "${path}.ngene-patch-${suffix}")
    file(WRITE "${temporary}" "${content}")
    foreach(attempt RANGE 1 10)
        file(RENAME "${temporary}" "${path}" RESULT status)
        if(status STREQUAL "0")
            return()
        endif()
        if(attempt LESS 10)
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.1)
        endif()
    endforeach()
    message(FATAL_ERROR "Cannot replace generated RFIC source ${path}: ${status}. Prepared source: ${temporary}")
endfunction()

function(ngene_apply_source_patch patch directory)
    file(READ "${patch}" remaining)
    set(path "")
    set(content "")
    set(active FALSE)
    set(old_text "")
    set(new_text "")
    while(NOT remaining STREQUAL "")
        string(FIND "${remaining}" "\n" newline)
        if(newline LESS 0)
            set(line "${remaining}")
            set(remaining "")
        else()
            string(SUBSTRING "${remaining}" 0 ${newline} line)
            math(EXPR next "${newline} + 1")
            string(SUBSTRING "${remaining}" ${next} -1 remaining)
        endif()
        if(line MATCHES "^(diff |@@|--- |\\+\\+\\+ )")
            if(active)
                ngene_replace_patch_hunk("${path}" "${content}" "${old_text}" "${new_text}" content)
            endif()
            set(active FALSE)
            set(old_text "")
            set(new_text "")
            if(line MATCHES "^\\+\\+\\+ ([^ \t]+)")
                get_filename_component(name "${CMAKE_MATCH_1}" NAME)
                if(NOT name MATCHES "^[a-zA-Z0-9_]+\\.[ch]$")
                    message(FATAL_ERROR "Unexpected pinned RFIC patch file: ${name}")
                endif()
                if(NOT path STREQUAL "")
                    ngene_write_patched_source("${path}" "${content}")
                endif()
                set(path "${directory}/${name}")
                file(READ "${path}" content)
            elseif(line MATCHES "^@@")
                set(active TRUE)
            endif()
        elseif(active AND NOT line STREQUAL "")
            string(SUBSTRING "${line}" 0 1 prefix)
            string(SUBSTRING "${line}" 1 -1 text)
            if(prefix STREQUAL " " OR prefix STREQUAL "-")
                string(APPEND old_text "${text}\n")
            endif()
            if(prefix STREQUAL " " OR prefix STREQUAL "+")
                string(APPEND new_text "${text}\n")
            endif()
        endif()
    endwhile()
    if(active)
        ngene_replace_patch_hunk("${path}" "${content}" "${old_text}" "${new_text}" content)
    endif()
    if(NOT path STREQUAL "")
        ngene_write_patched_source("${path}" "${content}")
    endif()
endfunction()
