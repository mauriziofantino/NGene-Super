# Select dependency architecture before project(), without confusing host and target.
function(ngene_windows_triplet output)
    set(architecture "")
    if(CMAKE_GENERATOR_PLATFORM)
        string(REPLACE "," ";" platform_options "${CMAKE_GENERATOR_PLATFORM}")
        list(GET platform_options 0 platform)
        if(NOT platform MATCHES "=")
            set(architecture "${platform}")
        endif()
    endif()
    if(NOT architecture AND CMAKE_GENERATOR MATCHES "^Visual Studio")
        set(architecture "${CMAKE_VS_PLATFORM_NAME_DEFAULT}")
    elseif(NOT architecture)
        if(CMAKE_C_COMPILER_TARGET)
            string(REGEX MATCH "^[^-]+" architecture "${CMAKE_C_COMPILER_TARGET}")
        elseif(CMAKE_SYSTEM_PROCESSOR)
            set(architecture "${CMAKE_SYSTEM_PROCESSOR}")
        elseif(NOT "$ENV{VSCMD_ARG_TGT_ARCH}" STREQUAL "")
            set(architecture "$ENV{VSCMD_ARG_TGT_ARCH}")
        endif()
    endif()
    if(NOT architecture)
        if(NOT "$ENV{PROCESSOR_ARCHITEW6432}" STREQUAL "")
            set(architecture "$ENV{PROCESSOR_ARCHITEW6432}")
        elseif(NOT "$ENV{PROCESSOR_ARCHITECTURE}" STREQUAL "")
            set(architecture "$ENV{PROCESSOR_ARCHITECTURE}")
        else()
            set(architecture "${CMAKE_HOST_SYSTEM_PROCESSOR}")
        endif()
    endif()
    string(TOLOWER "${architecture}" architecture)
    if(architecture MATCHES "^(x64|amd64|x86_64|x86-64)$")
        set(triplet x64-windows)
    elseif(architecture MATCHES "^(arm64|aarch64)$")
        set(triplet arm64-windows)
    elseif(architecture MATCHES "^(win32|x86|i[3-6]86)$")
        set(triplet x86-windows)
    elseif(architecture STREQUAL "arm")
        set(triplet arm-windows)
    else()
        message(FATAL_ERROR "Cannot select Windows dependencies for target '${architecture}'. Select a generator platform or set VCPKG_TARGET_TRIPLET explicitly.")
    endif()
    set(${output} "${triplet}" PARENT_SCOPE)
endfunction()
