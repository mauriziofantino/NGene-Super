# Build the upstream C library and RFIC support without CLI utilities, firmware,
# C++ CyAPI, shell patch programs, or upstream host-wide build side effects.
# Source lists and template headers come from the hash-pinned official release.
function(ngene_build_bladerf source rfic_source)
    set(host "${source}/host")
    set(library "${host}/libraries/libbladeRF")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/bladerf-native")
    set(rfic "${generated}/rfic")
    file(MAKE_DIRECTORY "${rfic}" "${generated}/src/backend")
    foreach(name ad9361.c ad9361.h ad9361_api.c ad9361_api.h ad9361_conv.c common.h util.c util.h)
        configure_file("${rfic_source}/ad9361/sw/${name}" "${rfic}/${name}" COPYONLY)
    endforeach()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ApplySourcePatch.cmake")
    file(GLOB patches "${source}/thirdparty/analogdevicesinc/no-OS_local/patches/*.patch")
    list(SORT patches)
    list(LENGTH patches count)
    if(NOT count EQUAL 6)
        message(FATAL_ERROR "Unexpected RFIC patch set in pinned bladeRF release")
    endif()
    foreach(patch IN LISTS patches)
        ngene_apply_source_patch("${patch}" "${rfic}")
    endforeach()
    set(BLADERF_OS_LINUX 0)
    set(BLADERF_OS_WINDOWS 0)
    set(BLADERF_OS_OSX 0)
    if(WIN32)
        set(BLADERF_OS_WINDOWS 1)
        set(HAVE_CLOCK_GETTIME 0)
    elseif(APPLE)
        set(BLADERF_OS_OSX 1)
        set(HAVE_CLOCK_GETTIME 1)
    else()
        set(BLADERF_OS_LINUX 1)
        set(HAVE_CLOCK_GETTIME 1)
    endif()
    configure_file("${host}/common/include/host_config.h.in" "${generated}/host_config.h" @ONLY)
    set(ENABLE_BACKEND_USB TRUE)
    set(ENABLE_BACKEND_LIBUSB TRUE)
    configure_file("${library}/src/backend/backend_config.h.in" "${generated}/src/backend/backend_config.h")
    set(VERSION "2.6.0")
    set(VERSION_INFO "2.6.0")
    set(VERSION_INFO_MAJOR 2)
    set(VERSION_INFO_MINOR 6)
    set(VERSION_INFO_PATCH 0)
    configure_file("${library}/src/version.h.in" "${generated}/src/version.h" @ONLY)
    set(BLADERF_HOST_COMMON_SOURCE_DIR "${host}/common/src")
    set(BLADERF_FPGA_COMMON_SOURCE_DIR "${source}/fpga_common/src")
    file(READ "${library}/CMakeLists.txt" upstream)
    set(files)
    foreach(variable LIBBLADERF_SOURCE LIBBLADERF_SOURCE_BLADERF2)
        string(REGEX MATCH "set\\(${variable}[ \r\n]+([^\\)]+)\\)" match "${upstream}")
        if(NOT match)
            message(FATAL_ERROR "Cannot read ${variable} from pinned bladeRF source")
        endif()
        # Split upstream tokens before expanding path variables, preserving spaces
        # in checkout/build directories on Windows, macOS and Linux.
        string(STRIP "${CMAKE_MATCH_1}" tokens)
        string(REGEX REPLACE "[ \r\n]+" ";" entries "${tokens}")
        foreach(entry IN LISTS entries)
            string(CONFIGURE "${entry}" entry)
            if(entry STREQUAL "src/version.h")
                list(APPEND files "${generated}/src/version.h")
            elseif(IS_ABSOLUTE "${entry}")
                list(APPEND files "${entry}")
            else()
                list(APPEND files "${library}/${entry}")
            endif()
        endforeach()
    endforeach()
    foreach(name nios_access nios_legacy_access usb libusb)
        list(APPEND files "${library}/src/backend/usb/${name}.c")
    endforeach()
    if(WIN32)
        list(APPEND files "${host}/common/src/windows/clock_gettime.c" "${host}/common/src/windows/setenv.c")
    endif()
    set(includes "${library}/include" "${library}/src" "${host}/common/include"
        "${source}/firmware_common" "${source}/fpga_common/include"
        "${generated}" "${generated}/src")
    if(WIN32)
        list(APPEND includes "${host}/common/include/windows")
    elseif(APPLE)
        list(APPEND includes "${host}/common/include/osx")
    endif()
    set(platform "${source}/thirdparty/analogdevicesinc/no-OS_local/platform_bladerf2")
    add_library(ngene_ad936x STATIC "${rfic}/ad9361.c" "${rfic}/ad9361_api.c"
        "${rfic}/ad9361_conv.c" "${rfic}/util.c" "${platform}/platform.c"
        "${platform}/adc_core.c" "${platform}/dac_core.c" "${source}/fpga_common/src/ad936x_params.c")
    set_target_properties(ngene_ad936x PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_include_directories(ngene_ad936x SYSTEM PRIVATE ${includes} "${rfic}" "${platform}")
    target_compile_definitions(ngene_ad936x PRIVATE NUAND_MODIFICATIONS)
    target_link_libraries(ngene_ad936x PRIVATE Threads::Threads)
    add_library(ngene_bladerf_native SHARED ${files})
    target_include_directories(ngene_bladerf_native SYSTEM PRIVATE ${includes} "${rfic}" "${platform}")
    if(NOT WIN32)
        target_include_directories(ngene_bladerf_native SYSTEM INTERFACE "${library}/include")
    else()
        ngene_bladerf_import_header("${library}/include" ngene_bladerf_native)
    endif()
    target_compile_definitions(ngene_bladerf_native PRIVATE LOGGING_ENABLED
        LIBBLADERF_SEARCH_PREFIX="${CMAKE_INSTALL_PREFIX}")
    foreach(target ngene_ad936x ngene_bladerf_native)
        ngene_external_target(${target})
        if(WIN32)
            target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS HAVE_STRUCT_TIMESPEC)
        else()
            target_compile_definitions(${target} PRIVATE _DEFAULT_SOURCE)
            target_link_libraries(${target} PRIVATE m)
        endif()
    endforeach()
    target_link_libraries(ngene_bladerf_native PRIVATE ngene_ad936x ngene_libusb Threads::Threads)
    set_target_properties(ngene_bladerf_native PROPERTIES OUTPUT_NAME bladeRF)
    install(TARGETS ngene_bladerf_native RUNTIME DESTINATION bin LIBRARY DESTINATION lib ARCHIVE DESTINATION lib)
    install(DIRECTORY "${source}/legal/licenses/" DESTINATION share/ngene/licenses/bladeRF)
    install(FILES "${source}/COPYING" DESTINATION share/ngene/licenses RENAME libbladeRF-COPYING OPTIONAL)
endfunction()
