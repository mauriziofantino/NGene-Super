# Test-only compiler fixtures must not inherit deeply nested checkout/build paths.
# MSBuild FileTracker still rejects some paths beyond MAX_PATH even when other
# tools accept them. Keep source and build roots short without changing OS policy.
function(ngene_test_scratch output)
    if(CMAKE_HOST_WIN32)
        set(root "$ENV{TEMP}")
        if(NOT root)
            set(root "$ENV{TMP}")
        endif()
        if(NOT root)
            message(FATAL_ERROR "Windows compiler tests require TEMP or TMP")
        endif()
    elseif(DEFINED ENV{TMPDIR} AND NOT "$ENV{TMPDIR}" STREQUAL "")
        set(root "$ENV{TMPDIR}")
    else()
        set(root "/tmp")
    endif()
    file(TO_CMAKE_PATH "${root}" root)
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef unique)
    set(path "${root}/ngt-${unique}")
    while(EXISTS "${path}")
        string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef unique)
        set(path "${root}/ngt-${unique}")
    endwhile()
    file(MAKE_DIRECTORY "${path}")
    set(${output} "${path}" PARENT_SCOPE)
endfunction()
