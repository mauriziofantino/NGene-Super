# Embed first-party static assets at configure time; no Node/Python runtime needed.
function(ngene_embed_web output)
    file(WRITE "${output}" "/** @file web_assets.h @brief Generated static asset declarations. */\n#ifndef NGENE_WEB_ASSETS_H\n#define NGENE_WEB_ASSETS_H\n#include <stddef.h>\n")
    set(implementation "${CMAKE_CURRENT_BINARY_DIR}/generated/web_assets.c")
    file(WRITE "${implementation}" "/** @file web_assets.c @brief Generated immutable web assets. */\n#include \"web_assets.h\"\n")
    foreach(name index.html app.js workspace.js receiver-config.js module-parameters.js module-parameters.json style.css ngene-logo.svg)
        set(path "${CMAKE_CURRENT_SOURCE_DIR}/web/${name}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        file(READ "${path}" bytes HEX)
        string(LENGTH "${bytes}" digits)
        math(EXPR count "${digits} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," array "${bytes}")
        string(REPLACE "," ",\n" array "${array}")
        if(name STREQUAL "index.html")
            set(symbol ngIndexHtml)
        elseif(name STREQUAL "app.js")
            set(symbol ngAppJs)
        elseif(name STREQUAL "workspace.js")
            set(symbol ngWorkspaceJs)
        elseif(name STREQUAL "receiver-config.js")
            set(symbol ngReceiverConfigJs)
        elseif(name STREQUAL "module-parameters.js")
            set(symbol ngModuleParametersJs)
        elseif(name STREQUAL "module-parameters.json")
            set(symbol ngModuleParametersJson)
        elseif(name STREQUAL "style.css")
            set(symbol ngStyleCss)
        else()
            set(symbol ngLogoSvg)
        endif()
        file(APPEND "${output}" "/** Embedded bytes of ${name}. */\nextern const unsigned char ${symbol}[];\n/** Length in bytes, excluding any terminator. */\nextern const size_t ${symbol}Length;\n")
        file(APPEND "${implementation}" "/** Immutable embedded ${name}. */\nconst unsigned char ${symbol}[] = {${array}};\n/** Embedded byte count. */\nconst size_t ${symbol}Length = ${count};\n")
    endforeach()
    file(APPEND "${output}" "#endif\n")
endfunction()
