# Inspect compiler target macros, not host uname; safe for cross compilation.
include(CheckCSourceCompiles)
check_c_source_compiles("#if !defined(__aarch64__) && !defined(_M_ARM64)\n#error not arm64\n#endif\nint main(void){return 0;}" NG_TARGET_ARM64)
check_c_source_compiles("#if !defined(__x86_64__) && !defined(_M_X64)\n#error not x64\n#endif\nint main(void){return 0;}" NG_TARGET_X64)
if(NG_TARGET_ARM64)
    set(NGENE_ARCH arm64)
elseif(NG_TARGET_X64)
    set(NGENE_ARCH x86_64)
else()
    check_c_source_compiles("#if !defined(__arm__) && !defined(_M_ARM)\n#error not arm\n#endif\nint main(void){return 0;}" NG_TARGET_ARM)
    check_c_source_compiles("#if !defined(__i386__) && !defined(_M_IX86)\n#error not x86\n#endif\nint main(void){return 0;}" NG_TARGET_X86)
    if(NG_TARGET_ARM)
        set(NGENE_ARCH arm)
    elseif(NG_TARGET_X86)
        set(NGENE_ARCH x86)
    else()
        message(FATAL_ERROR "Compiler target is neither x86 nor ARM")
    endif()
endif()
# Future SIMD targets use private ISA flags; no global -march=native/AVX/NEON.
