# Runs before project(): vcpkg's toolchain must be selected before compiler detection.
function(ngene_prepare_dependencies)
    option(NGENE_BOOTSTRAP_VCPKG "Discover or bootstrap pinned vcpkg for native Windows HackRF dependencies" OFF)
    if(NOT NGENE_BOOTSTRAP_VCPKG)
        return()
    endif()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/DependencyLock.cmake")
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/vcpkg.json" manifest)
    string(JSON baseline GET "${manifest}" builtin-baseline)
    if(NOT baseline STREQUAL NGENE_VCPKG_BASELINE)
        message(FATAL_ERROR "vcpkg.json and DependencyLock.cmake must use the same reviewed baseline")
    endif()
    if(NOT CMAKE_HOST_WIN32)
        message(FATAL_ERROR "NGENE_BOOTSTRAP_VCPKG is for a native Windows host")
    endif()
    if(NOT CMAKE_TOOLCHAIN_FILE)
        set(roots "$ENV{VCPKG_ROOT}" "$ENV{VCPKG_INSTALLATION_ROOT}")
        # Visual Studio ships vcpkg; discover installations without embedding a user path.
        set(vswhere "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer/vswhere.exe")
        if(EXISTS "${vswhere}")
            execute_process(COMMAND "${vswhere}" -products * -latest -property installationPath
                OUTPUT_VARIABLE visual_studio OUTPUT_STRIP_TRAILING_WHITESPACE)
            list(APPEND roots "${visual_studio}/VC/vcpkg")
        endif()
        foreach(root IN LISTS roots)
            if(EXISTS "${root}/scripts/buildsystems/vcpkg.cmake")
                set(CMAKE_TOOLCHAIN_FILE "${root}/scripts/buildsystems/vcpkg.cmake"
                    CACHE FILEPATH "Dependency toolchain discovered by NGene")
                break()
            endif()
        endforeach()
        if(NOT CMAKE_TOOLCHAIN_FILE)
            # A clean VS installation need not include vcpkg. Bootstrap it into the build tree.
            find_program(NGENE_GIT_EXECUTABLE git REQUIRED)
            set(root "${CMAKE_BINARY_DIR}/_deps/ngene-vcpkg")
            file(MAKE_DIRECTORY "${root}")
            execute_process(COMMAND "${NGENE_GIT_EXECUTABLE}" init "${root}" COMMAND_ERROR_IS_FATAL ANY)
            execute_process(COMMAND "${NGENE_GIT_EXECUTABLE}" -C "${root}" fetch --depth 1
                https://github.com/microsoft/vcpkg.git "${NGENE_VCPKG_BASELINE}" COMMAND_ERROR_IS_FATAL ANY)
            execute_process(COMMAND "${NGENE_GIT_EXECUTABLE}" -C "${root}" checkout --detach FETCH_HEAD
                COMMAND_ERROR_IS_FATAL ANY)
            set(CMAKE_TOOLCHAIN_FILE "${root}/scripts/buildsystems/vcpkg.cmake" CACHE FILEPATH "Dependency toolchain bootstrapped by NGene")
        endif()
        get_filename_component(toolchain_directory "${CMAKE_TOOLCHAIN_FILE}" DIRECTORY)
        get_filename_component(root "${toolchain_directory}/../.." ABSOLUTE)
        if(NOT EXISTS "${root}/vcpkg.exe")
            execute_process(COMMAND cmd /c "${root}/bootstrap-vcpkg.bat" -disableMetrics
                WORKING_DIRECTORY "${root}" COMMAND_ERROR_IS_FATAL ANY)
        endif()
    endif()
    if(NOT VCPKG_TARGET_TRIPLET)
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/WindowsTarget.cmake")
        ngene_windows_triplet(triplet)
        set(VCPKG_TARGET_TRIPLET "${triplet}" CACHE STRING "Native dependency target")
    endif()
    # Keep caller-selected features while always supplying NGene's required USB packages.
    set(features ${VCPKG_MANIFEST_FEATURES} hackrf)
    list(REMOVE_DUPLICATES features)
    set(VCPKG_MANIFEST_MODE ON CACHE BOOL "Use the versioned dependency manifest" FORCE)
    set(VCPKG_MANIFEST_FEATURES "${features}" CACHE STRING "Required dependency features" FORCE)
    set(VCPKG_MANIFEST_DIR "${CMAKE_CURRENT_SOURCE_DIR}" CACHE PATH "Versioned NGene manifest" FORCE)
endfunction()
