# Resolve an installed SDK first, or build only the upstream C library (not hackrf-tools).
function(ngene_resolve_hackrf)
    set(NGENE_HACKRF_PROVIDER AUTO CACHE STRING "HackRF provider: AUTO, SYSTEM or SOURCE")
    set_property(CACHE NGENE_HACKRF_PROVIDER PROPERTY STRINGS AUTO SYSTEM SOURCE)
    if(NOT NGENE_HACKRF_PROVIDER MATCHES "^(AUTO|SYSTEM|SOURCE)$")
        message(FATAL_ERROR "NGENE_HACKRF_PROVIDER must be AUTO, SYSTEM or SOURCE")
    endif()
    if(NOT NGENE_HACKRF_PROVIDER STREQUAL "SOURCE")
        find_package(HackRF QUIET)
        if(HackRF_FOUND)
            if(WIN32)
                # An installed upstream SDK can carry the same unconditional export macro.
                # Adapt only NGene's include view; never modify the SDK or its imported target.
                include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/HackRFHeader.cmake")
                find_path(NGENE_HACKRF_SDK_HEADER_DIR hackrf.h
                    HINTS ${HACKRF_INCLUDE_DIR} NO_DEFAULT_PATH REQUIRED)
                set(consumer_directory "${CMAKE_CURRENT_BINARY_DIR}/generated/hackrf-import")
                ngene_hackrf_consumer_header("${NGENE_HACKRF_SDK_HEADER_DIR}/hackrf.h"
                    "${consumer_directory}/hackrf.h")
                target_include_directories(ngene_core SYSTEM BEFORE PRIVATE "${consumer_directory}")
            endif()
            message(STATUS "NGene HackRF provider: installed library")
            return()
        elseif(NGENE_HACKRF_PROVIDER STREQUAL "SYSTEM")
            find_package(HackRF REQUIRED)
        endif()
    endif()
    set(NGENE_HACKRF_SOURCE_DIR "$ENV{HACKRF_SOURCE_DIR}" CACHE PATH "Existing upstream HackRF source tree; empty downloads the selected release")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/DependencyLock.cmake")
    set(NGENE_HACKRF_TAG ${NGENE_LOCK_HACKRF_TAG} CACHE STRING "Upstream release used for the optional source build")
    if(NGENE_HACKRF_SOURCE_DIR)
        set(source "${NGENE_HACKRF_SOURCE_DIR}")
        set(library_release "local-source")
    else()
        include(FetchContent)
        set(NGENE_HACKRF_SHA256 "" CACHE STRING "SHA256 required when selecting a non-default HackRF release")
        if(NGENE_HACKRF_TAG STREQUAL NGENE_LOCK_HACKRF_TAG AND NOT NGENE_HACKRF_SHA256)
            set(NGENE_HACKRF_SHA256 "${NGENE_LOCK_HACKRF_SHA256}")
        endif()
        if(NOT NGENE_HACKRF_SHA256 MATCHES "^[0-9a-fA-F]+$" OR NOT NGENE_HACKRF_SHA256)
            message(FATAL_ERROR "A custom HackRF release requires NGENE_HACKRF_SHA256; the default is already pinned")
        endif()
        # Deliberately build only the library, without upstream hackrf-tools/FFTW.
        FetchContent_Declare(ngene_hackrf_source
            URL "https://codeload.github.com/greatscottgadgets/hackrf/tar.gz/refs/tags/${NGENE_HACKRF_TAG}"
            URL_HASH "SHA256=${NGENE_HACKRF_SHA256}" SYSTEM
            DOWNLOAD_EXTRACT_TIMESTAMP FALSE SOURCE_SUBDIR ngene-no-upstream-build)
        FetchContent_MakeAvailable(ngene_hackrf_source)
        set(source "${ngene_hackrf_source_SOURCE_DIR}")
        set(library_release "${NGENE_HACKRF_TAG}")
    endif()
    if(EXISTS "${source}/host/libhackrf/src/hackrf.c")
        set(libsource "${source}/host/libhackrf/src")
    elseif(EXISTS "${source}/src/hackrf.c")
        set(libsource "${source}/src")
    else()
        message(FATAL_ERROR "NGENE_HACKRF_SOURCE_DIR must be the HackRF repository or host/libhackrf directory")
    endif()
    find_path(NGENE_USB_INCLUDE_DIR libusb.h PATH_SUFFIXES libusb-1.0 REQUIRED)
    find_library(NGENE_USB_LIBRARY NAMES usb-1.0 libusb-1.0 REQUIRED)
    add_library(ngene_hackrf_native SHARED "${libsource}/hackrf.c")
    ngene_external_target(ngene_hackrf_native)
    target_include_directories(ngene_hackrf_native SYSTEM PRIVATE "${libsource}" "${NGENE_USB_INCLUDE_DIR}")
    if(WIN32)
        # Upstream 2026.01.3 forces dllexport in its public header. Its DLL must see that
        # header, but callers need dllimport. Generate a consumer copy preserving the ABI
        # and license; never mutate the fetched or caller-supplied source tree.
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/HackRFHeader.cmake")
        set(consumer_directory "${CMAKE_CURRENT_BINARY_DIR}/generated/hackrf-import")
        ngene_hackrf_consumer_header("${libsource}/hackrf.h" "${consumer_directory}/hackrf.h")
        target_include_directories(ngene_hackrf_native SYSTEM INTERFACE "${consumer_directory}")
    else()
        target_include_directories(ngene_hackrf_native SYSTEM INTERFACE "${libsource}")
    endif()
    # libusb ships no CMake package in vcpkg. Preserve configuration-specific import libraries.
    add_library(ngene_libusb UNKNOWN IMPORTED)
    set_target_properties(ngene_libusb PROPERTIES IMPORTED_LOCATION "${NGENE_USB_LIBRARY}"
        INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${NGENE_USB_INCLUDE_DIR}"
        INTERFACE_INCLUDE_DIRECTORIES "${NGENE_USB_INCLUDE_DIR}")
    if(WIN32 AND VCPKG_INSTALLED_DIR AND VCPKG_TARGET_TRIPLET)
        find_library(NGENE_USB_LIBRARY_DEBUG NAMES usb-1.0 libusb-1.0
            PATHS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/debug/lib" NO_DEFAULT_PATH REQUIRED)
        set_target_properties(ngene_libusb PROPERTIES
            IMPORTED_CONFIGURATIONS "Debug;Release"
            IMPORTED_LOCATION_DEBUG "${NGENE_USB_LIBRARY_DEBUG}"
            IMPORTED_LOCATION_RELEASE "${NGENE_USB_LIBRARY}"
            MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release MAP_IMPORTED_CONFIG_MINSIZEREL Release)
    endif()
    target_link_libraries(ngene_hackrf_native PRIVATE ngene_libusb)
    if(WIN32)
        # This release owns ADD_EXPORTS in hackrf.h; do not redefine it on the command line.
        find_package(PThreads4W CONFIG REQUIRED)
        target_link_libraries(ngene_hackrf_native PRIVATE PThreads4W::PThreads4W)
        target_compile_definitions(ngene_hackrf_native PRIVATE _CRT_SECURE_NO_WARNINGS)
    else()
        target_link_libraries(ngene_hackrf_native PRIVATE Threads::Threads)
        target_compile_definitions(ngene_hackrf_native PRIVATE _POSIX_C_SOURCE=200809L)
    endif()
    # Both legacy 0.9 and current 0.10 sources accept these build metadata macros.
    file(READ "${libsource}/../CMakeLists.txt" upstream_cmake)
    set(library_version "unknown")
    if(upstream_cmake MATCHES "set\\(MINOR_VERSION ([0-9]+)\\)")
        set(library_version "0.${CMAKE_MATCH_1}")
    elseif(upstream_cmake MATCHES "project\\([^)]*VERSION[ \r\n]+([0-9]+\\.[0-9]+\\.[0-9]+)")
        set(library_version "${CMAKE_MATCH_1}")
    endif()
    target_compile_definitions(ngene_hackrf_native PRIVATE LIBRARY_VERSION="${library_version}" LIBRARY_RELEASE="${library_release}")
    set_target_properties(ngene_hackrf_native PROPERTIES OUTPUT_NAME hackrf)
    add_library(HackRF::HackRF ALIAS ngene_hackrf_native)
    set(HACKRF_INCLUDE_DIR "${libsource}" PARENT_SCOPE)
    if(WIN32)
        install(FILES "${consumer_directory}/hackrf.h" DESTINATION include/libhackrf)
    else()
        install(FILES "${libsource}/hackrf.h" DESTINATION include/libhackrf)
    endif()
    # Preserve the upstream license, including when building a caller-supplied tree.
    foreach(license "${libsource}/../COPYING" "${source}/COPYING" "${source}/host/libhackrf/COPYING")
        if(EXISTS "${license}")
            install(FILES "${license}" DESTINATION share/ngene/licenses RENAME libhackrf-COPYING)
            break()
        endif()
    endforeach()
    install(TARGETS ngene_hackrf_native RUNTIME DESTINATION bin LIBRARY DESTINATION lib ARCHIVE DESTINATION lib)
    message(STATUS "NGene HackRF provider: upstream source ${source}; library ${library_version}")
endfunction()
