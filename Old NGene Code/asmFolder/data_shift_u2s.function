{
	movdqu_m2r(correction[0],xmm6);
	movdqu_m2r(sampleShiftMask[0],xmm7);
	
	/* starts elaboration and aligns output array to a 16 bytes boundary */
	#ifdef COMPILE_64_BIT
	offsetOut = (unsigned long long int)outputArray & 0x0f;
	#else
	offsetOut = (unsigned int)outputArray & 0x0f;
	#endif
	if(offsetOut!=0)
	{
		for(index=0;index<((int)16-(int)offsetOut) && index<arrayLength;index++)
		{
			#ifndef SHIFTED_BITS
			outputArray[index] = inputArray[index] - correction[0];
			#else
			outputArray[index] = ((unsigned char)inputArray[index]) >> SHIFTED_BITS;
			outputArray[index] = (char)outputArray[index] - correction[0];
			#endif 
		}	
	}
	#ifdef COMPILE_64_BIT
	offsetIn = (unsigned long long int)(&(inputArray[index])) & 0x0f;
	#else
	offsetIn = (unsigned int)(&(inputArray[index])) & 0x0f;
	#endif
	/**/
	if(offsetIn == 0) /* if input array is aligned to a 16 bytes boundary, movdqa_m2r is used */
	{
		while((index+96)<=arrayLength)
		{
			movdqa_m2r(inputArray[index]   ,xmm0);
			movdqa_m2r(inputArray[index+16],xmm1);
			movdqa_m2r(inputArray[index+32],xmm2);
			movdqa_m2r(inputArray[index+48],xmm3);
			movdqa_m2r(inputArray[index+64],xmm4);
			movdqa_m2r(inputArray[index+80],xmm5);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			psrlw_i2r(SHIFTED_BITS,xmm2);
			psrlw_i2r(SHIFTED_BITS,xmm3);
			psrlw_i2r(SHIFTED_BITS,xmm4);
			psrlw_i2r(SHIFTED_BITS,xmm5);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			pand_r2r(xmm7,xmm2);
			pand_r2r(xmm7,xmm3);
			pand_r2r(xmm7,xmm4);
			pand_r2r(xmm7,xmm5);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			psubb_r2r(xmm6,xmm2);
			psubb_r2r(xmm6,xmm3);
			psubb_r2r(xmm6,xmm4);
			psubb_r2r(xmm6,xmm5);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			movdqa_r2m(xmm2,outputArray[index+32]);
			movdqa_r2m(xmm3,outputArray[index+48]);
			movdqa_r2m(xmm4,outputArray[index+64]);
			movdqa_r2m(xmm5,outputArray[index+80]);
			index += 96;
		}
		if((index+80)<=arrayLength)
		{
			movdqa_m2r(inputArray[index]   ,xmm0);
			movdqa_m2r(inputArray[index+16],xmm1);
			movdqa_m2r(inputArray[index+32],xmm2);
			movdqa_m2r(inputArray[index+48],xmm3);
			movdqa_m2r(inputArray[index+64],xmm4);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			psrlw_i2r(SHIFTED_BITS,xmm2);
			psrlw_i2r(SHIFTED_BITS,xmm3);
			psrlw_i2r(SHIFTED_BITS,xmm4);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			pand_r2r(xmm7,xmm2);
			pand_r2r(xmm7,xmm3);
			pand_r2r(xmm7,xmm4);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			psubb_r2r(xmm6,xmm2);
			psubb_r2r(xmm6,xmm3);
			psubb_r2r(xmm6,xmm4);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			movdqa_r2m(xmm2,outputArray[index+32]);
			movdqa_r2m(xmm3,outputArray[index+48]);
			movdqa_r2m(xmm4,outputArray[index+64]);
			index += 80;
		}
		if((index+64)<=arrayLength)
		{
			movdqa_m2r(inputArray[index]   ,xmm0);
			movdqa_m2r(inputArray[index+16],xmm1);
			movdqa_m2r(inputArray[index+32],xmm2);
			movdqa_m2r(inputArray[index+48],xmm3);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			psrlw_i2r(SHIFTED_BITS,xmm2);
			psrlw_i2r(SHIFTED_BITS,xmm3);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			pand_r2r(xmm7,xmm2);
			pand_r2r(xmm7,xmm3);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			psubb_r2r(xmm6,xmm2);
			psubb_r2r(xmm6,xmm3);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			movdqa_r2m(xmm2,outputArray[index+32]);
			movdqa_r2m(xmm3,outputArray[index+48]);
			index += 64;
		}
		if((index+48)<=arrayLength)
		{
			movdqa_m2r(inputArray[index]   ,xmm0);
			movdqa_m2r(inputArray[index+16],xmm1);
			movdqa_m2r(inputArray[index+32],xmm2);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			psrlw_i2r(SHIFTED_BITS,xmm2);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			pand_r2r(xmm7,xmm2);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			psubb_r2r(xmm6,xmm2);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			movdqa_r2m(xmm2,outputArray[index+32]);
			index += 48;
		}
		if((index+32)<=arrayLength)
		{
			movdqa_m2r(inputArray[index]   ,xmm0);
			movdqa_m2r(inputArray[index+16],xmm1);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			index += 32;
		}
		if((index+16)<=arrayLength)
		{
			movdqa_m2r(inputArray[index]   ,xmm0);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			pand_r2r(xmm7,xmm0);
			#endif
			psubb_r2r(xmm6,xmm0);
			movdqa_r2m(xmm0,outputArray[index]);
			index += 16;
		}
	}	
	else /* if input array is not aligned to a 16 bytes boundary, movdqu_m2r is used */
	{
		while((index+96)<=arrayLength)
		{
			movdqu_m2r(inputArray[index]   ,xmm0);
			movdqu_m2r(inputArray[index+16],xmm1);
			movdqu_m2r(inputArray[index+32],xmm2);
			movdqu_m2r(inputArray[index+48],xmm3);
			movdqu_m2r(inputArray[index+64],xmm4);
			movdqu_m2r(inputArray[index+80],xmm5);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			psrlw_i2r(SHIFTED_BITS,xmm2);
			psrlw_i2r(SHIFTED_BITS,xmm3);
			psrlw_i2r(SHIFTED_BITS,xmm4);
			psrlw_i2r(SHIFTED_BITS,xmm5);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			pand_r2r(xmm7,xmm2);
			pand_r2r(xmm7,xmm3);
			pand_r2r(xmm7,xmm4);
			pand_r2r(xmm7,xmm5);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			psubb_r2r(xmm6,xmm2);
			psubb_r2r(xmm6,xmm3);
			psubb_r2r(xmm6,xmm4);
			psubb_r2r(xmm6,xmm5);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			movdqa_r2m(xmm2,outputArray[index+32]);
			movdqa_r2m(xmm3,outputArray[index+48]);
			movdqa_r2m(xmm4,outputArray[index+64]);
			movdqa_r2m(xmm5,outputArray[index+80]);
			index += 96;
		}
		if((index+80)<=arrayLength)
		{
			movdqu_m2r(inputArray[index]   ,xmm0);
			movdqu_m2r(inputArray[index+16],xmm1);
			movdqu_m2r(inputArray[index+32],xmm2);
			movdqu_m2r(inputArray[index+48],xmm3);
			movdqu_m2r(inputArray[index+64],xmm4);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			psrlw_i2r(SHIFTED_BITS,xmm2);
			psrlw_i2r(SHIFTED_BITS,xmm3);
			psrlw_i2r(SHIFTED_BITS,xmm4);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			pand_r2r(xmm7,xmm2);
			pand_r2r(xmm7,xmm3);
			pand_r2r(xmm7,xmm4);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			psubb_r2r(xmm6,xmm2);
			psubb_r2r(xmm6,xmm3);
			psubb_r2r(xmm6,xmm4);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			movdqa_r2m(xmm2,outputArray[index+32]);
			movdqa_r2m(xmm3,outputArray[index+48]);
			movdqa_r2m(xmm4,outputArray[index+64]);
			index += 80;
		}
		if((index+64)<=arrayLength)
		{
			movdqu_m2r(inputArray[index]   ,xmm0);
			movdqu_m2r(inputArray[index+16],xmm1);
			movdqu_m2r(inputArray[index+32],xmm2);
			movdqu_m2r(inputArray[index+48],xmm3);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			psrlw_i2r(SHIFTED_BITS,xmm2);
			psrlw_i2r(SHIFTED_BITS,xmm3);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			pand_r2r(xmm7,xmm2);
			pand_r2r(xmm7,xmm3);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			psubb_r2r(xmm6,xmm2);
			psubb_r2r(xmm6,xmm3);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			movdqa_r2m(xmm2,outputArray[index+32]);
			movdqa_r2m(xmm3,outputArray[index+48]);
			index += 64;
		}
		if((index+48)<=arrayLength)
		{
			movdqu_m2r(inputArray[index]   ,xmm0);
			movdqu_m2r(inputArray[index+16],xmm1);
			movdqu_m2r(inputArray[index+32],xmm2);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			psrlw_i2r(SHIFTED_BITS,xmm2);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			pand_r2r(xmm7,xmm2);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			psubb_r2r(xmm6,xmm2);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			movdqa_r2m(xmm2,outputArray[index+32]);
			index += 48;
		}
		if((index+32)<=arrayLength)
		{
			movdqu_m2r(inputArray[index]   ,xmm0);
			movdqu_m2r(inputArray[index+16],xmm1);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			psrlw_i2r(SHIFTED_BITS,xmm1);
			pand_r2r(xmm7,xmm0);
			pand_r2r(xmm7,xmm1);
			#endif
			psubb_r2r(xmm6,xmm0);
			psubb_r2r(xmm6,xmm1);
			movdqa_r2m(xmm0,outputArray[index]);
			movdqa_r2m(xmm1,outputArray[index+16]);
			index += 32;
		}
		if((index+16)<=arrayLength)
		{
			movdqu_m2r(inputArray[index]   ,xmm0);
			#ifdef SHIFTED_BITS
			psrlw_i2r(SHIFTED_BITS,xmm0);
			pand_r2r(xmm7,xmm0);
			#endif
			psubb_r2r(xmm6,xmm0);
			movdqa_r2m(xmm0,outputArray[index]);
			index += 16;
		}
	}
	/**/
	for(;index<arrayLength;index++)
	{
		#ifndef SHIFTED_BITS
		outputArray[index] = inputArray[index] - correction[0];
		#else
		outputArray[index] = ((unsigned char)inputArray[index]) >> SHIFTED_BITS;
		outputArray[index] = (char)outputArray[index] - correction[0];
		#endif 
	}
}
