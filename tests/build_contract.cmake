# Guard reproducibility and DLL import/export contracts without a Windows SDK or a device.
include("${source}/cmake/DependencyLock.cmake")
file(READ "${source}/vcpkg.json" manifest)
string(JSON baseline GET "${manifest}" builtin-baseline)
string(LENGTH "${baseline}" length)
if(NOT length EQUAL 40 OR NOT baseline STREQUAL NGENE_VCPKG_BASELINE)
    message(FATAL_ERROR "Invalid or inconsistent versioned registry baseline")
endif()
string(LENGTH "${NGENE_LOCK_HACKRF_SHA256}" length)
if(NOT length EQUAL 64)
    message(FATAL_ERROR "HackRF source must have a SHA-256 pin")
endif()
file(MAKE_DIRECTORY "${work}")
set(header "#ifdef _WIN32\r\n\t#define ADD_EXPORTS\r\n#ifdef ADD_EXPORTS\r\n#define ADDAPI __declspec(dllexport)\r\n#else\r\n#define ADDAPI __declspec(dllimport)\r\n#endif\r\n#endif\r\n")
file(WRITE "${work}/original.h" "${header}")
file(SHA256 "${work}/original.h" before)
include("${source}/cmake/HackRFHeader.cmake")
ngene_hackrf_consumer_header("${work}/original.h" "${work}/import/hackrf.h")
file(SHA256 "${work}/original.h" after)
file(READ "${work}/import/hackrf.h" consumer)
if(NOT before STREQUAL after OR consumer MATCHES "#define ADD_EXPORTS")
    message(FATAL_ERROR "The consumer header mutates upstream or still forces DLL export")
endif()
if(NOT consumer MATCHES "#ifdef ADD_EXPORTS" OR NOT consumer MATCHES "dllimport")
    message(FATAL_ERROR "The upstream ABI import/export branches were changed")
endif()
# A corrected/custom SDK header must remain byte-for-byte unchanged.
file(WRITE "${work}/corrected.h" "${consumer}")
ngene_hackrf_consumer_header("${work}/corrected.h" "${work}/corrected-import.h")
file(READ "${work}/corrected-import.h" repeated)
if(NOT repeated STREQUAL consumer)
    message(FATAL_ERROR "The header normalization is not idempotent")
endif()
message(STATUS "PASS: manifest pin, source hash and immutable DLL import header")

# Exercise pre-project selection on every host; these are configuration tests,
# not a substitute for running MSVC or a Windows dependency installation.
include("${source}/cmake/WindowsTarget.cmake")
function(check_platform platform expected)
    set(CMAKE_GENERATOR_PLATFORM "${platform}")
    ngene_windows_triplet(actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Platform '${platform}' selected ${actual}; expected ${expected}")
    endif()
endfunction()
set(CMAKE_GENERATOR "Visual Studio 18 2026")
set(CMAKE_VS_PLATFORM_NAME_DEFAULT ARM64)
check_platform(x64 x64-windows)
check_platform(ARM64 arm64-windows)
check_platform("ARM64,version=10.0" arm64-windows)
check_platform("x64,version=10.0" x64-windows)
check_platform("version=10.0" arm64-windows)
check_platform("" arm64-windows)
check_platform(Win32 x86-windows)
set(CMAKE_VS_PLATFORM_NAME_DEFAULT x64)
check_platform("" x64-windows)
set(CMAKE_GENERATOR Ninja)
set(CMAKE_C_COMPILER_TARGET aarch64-pc-windows-msvc)
check_platform("" arm64-windows)
unset(CMAKE_C_COMPILER_TARGET)
set(CMAKE_SYSTEM_PROCESSOR ARM64)
check_platform("" arm64-windows)
unset(CMAKE_SYSTEM_PROCESSOR)

# A discovered, already bootstrapped SDK must require no Git/download/manual paths.
set(fake_root "${work}/vcpkg fixture")
file(MAKE_DIRECTORY "${fake_root}/scripts/buildsystems")
file(WRITE "${fake_root}/scripts/buildsystems/vcpkg.cmake" "# Test toolchain placeholder\n")
file(WRITE "${fake_root}/vcpkg.exe" "Test-only bootstrap marker\n")
set(ENV{VCPKG_ROOT} "${fake_root}")
set(CMAKE_HOST_WIN32 TRUE)
set(CMAKE_CURRENT_SOURCE_DIR "${source}")
set(CMAKE_GENERATOR "Visual Studio 18 2026")
set(CMAKE_GENERATOR_PLATFORM "ARM64,version=10.0")
unset(CMAKE_TOOLCHAIN_FILE)
unset(CMAKE_TOOLCHAIN_FILE CACHE)
unset(VCPKG_TARGET_TRIPLET)
unset(VCPKG_TARGET_TRIPLET CACHE)
set(NGENE_BOOTSTRAP_VCPKG ON CACHE BOOL "Test bootstrap")
set(VCPKG_MANIFEST_MODE OFF CACHE BOOL "Stale mode")
set(VCPKG_MANIFEST_FEATURES "retained-feature;hackrf;hackrf" CACHE STRING "Test features")
set(VCPKG_MANIFEST_DIR "${work}/old-project" CACHE PATH "Stale manifest")
include("${source}/cmake/Dependencies.cmake")
ngene_prepare_dependencies()
if(NOT CMAKE_TOOLCHAIN_FILE STREQUAL "${fake_root}/scripts/buildsystems/vcpkg.cmake"
    OR NOT VCPKG_TARGET_TRIPLET STREQUAL "arm64-windows"
    OR NOT VCPKG_MANIFEST_MODE
    OR NOT VCPKG_MANIFEST_DIR STREQUAL source
    OR NOT VCPKG_MANIFEST_FEATURES STREQUAL "retained-feature;hackrf")
    message(FATAL_ERROR "Discovery/target/manifest bootstrap did not preserve the required contract")
endif()
set(VCPKG_TARGET_TRIPLET "x64-windows-static" CACHE STRING "Explicit triplet" FORCE)
ngene_prepare_dependencies()
if(NOT VCPKG_TARGET_TRIPLET STREQUAL "x64-windows-static")
    message(FATAL_ERROR "Bootstrap changed an explicitly selected triplet")
endif()
message(STATUS "PASS: pre-project Windows target selection, discovery and manifest cache repair")

# Configure the SYSTEM provider against a fixture SDK with the upstream export bug.
# Only CMake's Windows provider branch is exercised; no Windows binary is built.
set(sdk_fixture "${work}/installed-sdk-fixture")
file(MAKE_DIRECTORY "${sdk_fixture}/sdk/include/libhackrf" "${sdk_fixture}/sdk/lib"
    "${sdk_fixture}/sdk/bin")
file(WRITE "${sdk_fixture}/sdk/include/libhackrf/hackrf.h" "${header}")
file(WRITE "${sdk_fixture}/sdk/lib/libhackrf.a" "Configuration-only fixture\n")
file(WRITE "${sdk_fixture}/sdk/lib/hackrf.lib" "Configuration-only fixture\n")
file(WRITE "${sdk_fixture}/sdk/bin/hackrf.dll" "Configuration-only fixture\n")
file(WRITE "${sdk_fixture}/dummy.c" "int Fixture(void) { return 0; }\n")
file(WRITE "${sdk_fixture}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.26)\nproject(ImportHeaderFixture LANGUAGES C)\nif(POLICY CMP0144)\ncmake_policy(SET CMP0144 NEW)\nendif()\nset(WIN32 TRUE)\nset(CMAKE_FIND_LIBRARY_PREFIXES lib \"\")\nset(CMAKE_FIND_LIBRARY_SUFFIXES .a .lib)\nlist(APPEND CMAKE_MODULE_PATH \"${source}/cmake\")\nadd_library(ngene_core STATIC dummy.c)\nset(HACKRF_ROOT \"${sdk_fixture}/sdk\")\nset(NGENE_HACKRF_PROVIDER SYSTEM CACHE STRING \"Fixture provider\")\ninclude(HackRFProvider)\nngene_resolve_hackrf()\nget_target_property(includes ngene_core INCLUDE_DIRECTORIES)\nif(NOT includes MATCHES \"generated/hackrf-import\")\nmessage(FATAL_ERROR \"Installed SDK consumer header was not selected\")\nendif()\n")
# This fixture configures with the host compiler but never compiles a vendor binary.
file(APPEND "${sdk_fixture}/CMakeLists.txt" "file(READ \"${sdk_fixture}/sdk/include/libhackrf/hackrf.h\" original)\nfile(READ \"\${CMAKE_CURRENT_BINARY_DIR}/generated/hackrf-import/hackrf.h\" consumer)\nif(NOT original MATCHES \"#define ADD_EXPORTS\" OR consumer MATCHES \"#define ADD_EXPORTS\")\nmessage(FATAL_ERROR \"Installed SDK export header was mutated or not normalized\")\nendif()\nset_target_properties(ngene_core PROPERTIES LINKER_LANGUAGE C)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${sdk_fixture}" -B "${sdk_fixture}/build"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Installed SDK import-header fixture failed: ${output}\n${errors}")
endif()
message(STATUS "PASS: installed SDK consumer import header, without changing SDK or target")

# Configure-only MSVC policy fixture: external warning settings must not leak to
# consumers. Native .vcxproj generation is checked by verify-windows.ps1 on Windows.
set(warning_fixture "${work}/warning-policy-fixture")
file(MAKE_DIRECTORY "${warning_fixture}")
file(WRITE "${warning_fixture}/dummy.c" "int Fixture(void) { return 0; }\n")
set(warning_project [=[
cmake_minimum_required(VERSION 3.26)
project(WarningPolicyFixture LANGUAGES C)
set(MSVC TRUE)
include("@source@/cmake/ThirdParty.cmake")
add_library(external STATIC dummy.c)
ngene_external_target(external)
add_library(receiver STATIC dummy.c)
target_link_libraries(receiver PRIVATE external)
target_compile_options(receiver PRIVATE "$<$<COMPILE_LANGUAGE:C>:/W4;/WX>")
get_target_property(vendor_flags external COMPILE_OPTIONS)
get_target_property(exported_flags external INTERFACE_COMPILE_OPTIONS)
get_target_property(receiver_flags receiver COMPILE_OPTIONS)
if(NOT vendor_flags STREQUAL "$<$<COMPILE_LANGUAGE:C>:/W0>" OR exported_flags)
    message(FATAL_ERROR "Vendor warning policy conflicts with MSBuild or leaks to consumers")
endif()
if(NOT receiver_flags STREQUAL "$<$<COMPILE_LANGUAGE:C>:/W4;/WX>")
    message(FATAL_ERROR "First-party /W4 /WX policy was changed")
endif()
]=])
string(CONFIGURE "${warning_project}" warning_project @ONLY)
file(WRITE "${warning_fixture}/CMakeLists.txt" "${warning_project}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${warning_fixture}" -B "${warning_fixture}/build"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Warning policy fixture failed: ${output}\n${errors}")
endif()
message(STATUS "PASS: PRIVATE MSVC /W0 for vendors; receiver /W4 /WX preserved (configure only)")
